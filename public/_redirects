# Cloudflare Pages always serves a real static file first (prerendered /learn/*, /compare/*,
# /app/current-affairs/*, /app/exam-notices/* pages) before ever consulting this file - these
# rules only run for paths with no matching file on disk.
#
# Use the extensionless fallback to avoid Cloudflare canonicalizing .html to a new URL.
# Onboarding has its own generated HTML entry.
# Known client-side-only screens (no prerendered HTML - correctly excluded from robots.txt) still
# need an explicit 200 here so real users/bookmarks/shares get the app, not a 404 interstitial.
/app/home                      /spa  200
/app/study                     /spa  200
/app/study/*                   /spa  200
/app/practice                  /spa  200
/app/practice/*                /spa  200
/app/mistakes                  /spa  200
/app/bookmarks                 /spa  200
/app/progress                  /spa  200
/app/digest                    /spa  200
/app/account                   /spa  200
/app/challenge                 /spa  200
/app/current-affairs-quiz      /spa  200
/app/current-affairs-quiz/*    /spa  200

# Unmatched paths use the generated 404.html (Cloudflare returns HTTP 404).

/daily-pdf /pdf/latest.pdf 302
/daily-pdf/ /pdf/latest.pdf 302

# Parent folders of real pages, which crawlers reach by trimming a URL - all four returned 404 until 2026-10-20
# (Cloudflare AI Crawl Control showed bursts of 4xx from Googlebot, ClaudeBot, PerplexityBot and others). Both
# spellings, because a rule matches the path exactly and these have no file on disk for Pages to normalise.
/app                                   /app/home                 302
/app/                                  /app/home                 302
/compare                               /exams/                   301
/compare/                              /exams/                   301
/hi/compare                            /hi/exams/                301
/hi/compare/                           /hi/exams/                301
/exams/:exam/question-papers           /exams/:exam/             301
/exams/:exam/question-papers/          /exams/:exam/             301

# Names other sites use, which crawlers request by habit.
/manifest.json                         /manifest.webmanifest     301
/llms-full.txt                         /llms.txt                 302

# G1 experiment (from 20 Oct 2026, review 3 Nov): the pilot line on four exam hubs links through these, so the clicks show
# up in Cloudflare Analytics > HTTP Traffic as requests to /go/hub-pdf and /go/hub-telegram (robots.txt keeps crawlers out).
/go/hub-pdf                            /pdf/latest.pdf           302
/go/hub-telegram                       https://t.me/parikshasaathiapp 302
